# Response headers for hosts that read a _headers file (Cloudflare Pages, Netlify).
# This header is the only Content-Security-Policy; the pages carry no <meta> copy, so a violation is reported once.
# style-src allows inline styles because Trello's client library (power-up.min.js) injects them; script-src stays strict.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://p.trellocdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.trello.com; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://trello.com https://*.trello.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
